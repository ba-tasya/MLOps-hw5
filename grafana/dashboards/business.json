        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT us_state, sum(amount) AS flagged_amount FROM scores WHERE $__timeFilter(created_at) AND fraud_flag = 1 AND us_state IN (${state:sqlstring}) AND merch IN (${merch:sqlstring}) GROUP BY us_state ORDER BY flagged_amount DESC LIMIT 15",
