      "title": "Fraud share by category (last 1000 transactions)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT cat_id, avg(fraud_flag) AS fraud_share FROM (SELECT cat_id, fraud_flag FROM scores ORDER BY id DESC LIMIT 1000) AS last_scores GROUP BY cat_id ORDER BY fraud_share DESC",
